{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        //for window: docker run -d --restart unless-stopped --name MrpDanuSeq -e ACCEPT_EULA=Y -v D:\Logs:/data -p 8081:80 datalust/seq:latest
        //for mac: docker pull datalust/seq
        //for mac: docker run -d --restart unless-stopped --name MrpDanuSeq -e ACCEPT_EULA=Y -v /Users/sonpham/Projects/SonPhamProjects/MrpDanu/MrpDanu.Logs:/data -p 8081:80 datalust/seq:latest
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": {
      "Application": "DDD.MrpDanu"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigin": "http://localhost:5288",
  "DatabaseSettings": {
    "MaxRetryCount": 10,
    "MaxRetryDelay": 30,
    "StandardExecutedDbCommandTime": 2000,
    "ConnectionString": "Server=localhost,1433;Database=DDD.MrpDanu;User Id=sa;Password=reallyStrongPwd123;TrustServerCertificate=true",
    //"ConnectionString": "Server=son-quang-pham-0131,1433;Database=DDD.MrpDanu;User Id=sa;Password=Vsa*12345#;TrustServerCertificate=true",
    "EnableLog": true
  },
  "MongoSettings": {
    // 27001: primary, 27002, 27003: secondaries, 27004: arbiter
    // When connecting to a MongoDB replica set in a .NET project, including the arbiter node in the connection string 
    // is not strictly necessary. Arbiters do not store data or participate in read/write operations; their main role is 
    // to break ties in elections for primary nodes. However, for completeness and to ensure the driver is aware of the 
    // full replica set configuration, you can include the arbiter in the connection string.
    "ConnectionString": "mongodb://localhost:27001,localhost:27002,localhost:27003,localhost:27004/?replicaSet=rs0"
  },
  "FeatureFlags": {
    "GcEventListener": true
  }
}
