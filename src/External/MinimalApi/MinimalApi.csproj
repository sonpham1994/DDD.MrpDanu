<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!--Use Directory.Build.props instead-->
    <!--	<PropertyGroup Condition="'$(Environment)' == 'Production'">-->
    <!--		<DefineConstants>$(DefineConstants);PRODUCTION</DefineConstants>-->
    <!--	</PropertyGroup>-->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Architecture.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <PropertyGroup Condition=" '$(RunConfiguration)' == 'Local' " />
    <ItemGroup>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Enrichers.Environment" />
        <PackageReference Include="Serilog.Enrichers.Process" />
        <PackageReference Include="Serilog.Enrichers.Thread" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    </ItemGroup>

    <ItemGroup Condition="'$(Environment)' != 'Production'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--doesn't use Serilog.Sinks.Seq on Production, just use for local. Ignoring this nuget when on production: https://chat.openai.com/share/73113f82-0505-4f16-9c35-6d423475164a-->
    <ItemGroup Condition="'$(Environment)' == 'Production'">
        <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
    </ItemGroup>
    <ItemGroup Condition="'$(Environment)' != 'Production'">
        <PackageReference Include="Serilog.Sinks.Seq" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Core\Application\Application.csproj" />
      <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

    <!--
      Auto-generate the JSON source-generator contexts (ApiResponse/ApiRequest) by scanning
      the Application assembly for marker interfaces (IApiResponse / IApiCollectionResponse /
      IValidationCommand). Runs only when an Application source file is newer than the generated
      file (Inputs/Outputs incrementality), so normal rebuilds skip it.
      Set GenerateJsonContexts=false (e.g. in CI) to skip and use the committed .g.cs as-is.
    -->
    <PropertyGroup>
        <GenerateJsonContexts Condition="'$(GenerateJsonContexts)' == ''">true</GenerateJsonContexts>
        <JsonContextsGeneratorProject>$(MSBuildThisFileDirectory)..\..\..\tools\JsonSerializerContextGenerator\JsonSerializerContextGenerator.csproj</JsonContextsGeneratorProject>
        <JsonContextsOutputFile>$(MSBuildThisFileDirectory)SourceGenerators\ApiJsonSerializerContexts.g.cs</JsonContextsOutputFile>
        <ApplicationProjectDir>$(MSBuildThisFileDirectory)..\..\Core\Application\</ApplicationProjectDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- Own the generated file: take it out of the default **/*.cs glob and include it once
             explicitly. The literal Include keeps it in @(Compile) even if the file is missing at
             evaluation time (the pre-build target regenerates it before CoreCompile). -->
        <Compile Remove="$(JsonContextsOutputFile)" />
        <Compile Include="$(JsonContextsOutputFile)" />

        <!-- Real Application sources only (no bin/obj) drive the incremental check. -->
        <JsonContextScanSource Include="$(ApplicationProjectDir)**\*.cs"
                               Exclude="$(ApplicationProjectDir)obj\**\*.cs;$(ApplicationProjectDir)bin\**\*.cs" />
    </ItemGroup>

    <Target Name="GenerateJsonContexts"
            BeforeTargets="CoreCompile"
            Condition="'$(GenerateJsonContexts)' == 'true'"
            Inputs="@(JsonContextScanSource)"
            Outputs="$(JsonContextsOutputFile)">
        <Exec Command="dotnet run --project &quot;$(JsonContextsGeneratorProject)&quot; --configuration $(Configuration) -- --output &quot;$(JsonContextsOutputFile)&quot; --namespace MinimalApi.SourceGenerators --api-response-namespace MinimalApi.ApiResponses" />
    </Target>

</Project>
