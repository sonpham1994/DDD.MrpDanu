<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!--Use Directory.Build.props instead-->
    <!--	<PropertyGroup Condition="'$(Environment)' == 'Production'">-->
    <!--		<DefineConstants>$(DefineConstants);PRODUCTION</DefineConstants>-->
    <!--	</PropertyGroup>-->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Architecture.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <PropertyGroup Condition=" '$(RunConfiguration)' == 'Local' " />
    <ItemGroup>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Enrichers.Environment" />
        <PackageReference Include="Serilog.Enrichers.Process" />
        <PackageReference Include="Serilog.Enrichers.Thread" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    </ItemGroup>

    <ItemGroup Condition="'$(Environment)' != 'Production'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--doesn't use Serilog.Sinks.Seq on Production, just use for local. Ignoring this nuget when on production: https://chat.openai.com/share/73113f82-0505-4f16-9c35-6d423475164a-->
    <ItemGroup Condition="'$(Environment)' == 'Production'">
        <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
    </ItemGroup>
    <ItemGroup Condition="'$(Environment)' != 'Production'">
        <PackageReference Include="Serilog.Sinks.Seq" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Core\Application\Application.csproj" />
      <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

    <!--
      Auto-generate the JSON source-generator contexts (ApiResponse/ApiRequest) by scanning the
      Application assembly for marker interfaces (IApiResponse / IApiCollectionResponse /
      IValidationCommand). The file is emitted into the intermediate (obj) folder, NOT the source
      tree, so it is never committed and never appears in Solution Explorer to be deleted/excluded
      by hand. It is still real source fed into @(Compile), so System.Text.Json's own source
      generator picks up its [JsonSerializable] attributes normally.
      Generation is incremental: it runs only when an Application source is newer than the output (or
      the output is missing). Set GenerateJsonContexts=false to skip it (the build then requires the
      obj file to already exist from a previous build).
    -->
    <PropertyGroup>
        <GenerateJsonContexts Condition="'$(GenerateJsonContexts)' == ''">true</GenerateJsonContexts>
        <JsonContextsGeneratorProject>$(MSBuildThisFileDirectory)..\..\..\tools\JsonSerializerContextGenerator\JsonSerializerContextGenerator.csproj</JsonContextsGeneratorProject>
        <!-- Use BaseIntermediateOutputPath ('obj\'), which the SDK props imported above already set.
             IntermediateOutputPath (obj\Debug\netX) is computed later and would be empty here. -->
        <JsonContextsOutputFile>$(BaseIntermediateOutputPath)ApiJsonSerializerContexts.g.cs</JsonContextsOutputFile>
        <ApplicationProjectDir>$(MSBuildThisFileDirectory)..\..\Core\Application\</ApplicationProjectDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- The file lives under obj\, which the SDK excludes from the default **/*.cs glob, so a
             single explicit Include owns it (no Remove needed). The literal Include keeps it in
             @(Compile) even when the file is missing at evaluation time (the pre-build target
             regenerates it before CoreCompile). -->
        <Compile Include="$(JsonContextsOutputFile)" />

        <!-- Real Application sources only (no bin/obj) drive the incremental check. -->
        <JsonContextScanSource Include="$(ApplicationProjectDir)**\*.cs" Exclude="$(ApplicationProjectDir)obj\**\*.cs;$(ApplicationProjectDir)bin\**\*.cs" />

        <!-- Teach Visual Studio's fast up-to-date check about the generated file so a missing or
             stale output forces a real build instead of VS reporting "up to date" and skipping. -->
        <UpToDateCheckBuilt Include="$(JsonContextsOutputFile)" />
        <UpToDateCheckInput Include="@(JsonContextScanSource)" />
    </ItemGroup>

    <Target Name="GenerateJsonContexts" BeforeTargets="CoreCompile" Condition="'$(GenerateJsonContexts)' == 'true'" Inputs="@(JsonContextScanSource)" Outputs="$(JsonContextsOutputFile)">
        <Exec Command="dotnet run --project &quot;$(JsonContextsGeneratorProject)&quot; --configuration $(Configuration) -- --output &quot;$(JsonContextsOutputFile)&quot; --namespace MinimalApi.SourceGenerators --api-response-namespace MinimalApi.ApiResponses" />
    </Target>

    <!--
      Force regeneration on Rebuild (= Clean + Build): delete the generated file during Clean so
      the GenerateJsonContexts Inputs/Outputs check sees a missing output and always re-runs on the
      following Build. A plain incremental Build is unaffected and still skips when nothing changed.
    -->
    <Target Name="DeleteGeneratedJsonContextsOnClean" AfterTargets="Clean" Condition="'$(GenerateJsonContexts)' == 'true'">
        <Delete Files="$(JsonContextsOutputFile)" />
    </Target>

</Project>
